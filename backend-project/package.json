{
  "name": "restaurant-management-online-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src/**/*"
    ],
    "exec": "node -r tsconfig-paths/register -r ts-node/register ./src/index.ts",
    "ext": "ts, js"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "nodemon",
    "test": "jest --coverage --silent",
    "test-print": "jest --coverage --silent --no-color 2>jest_report.txt",
    "start": "node dist/index.js",
    "codegen": "graphql-codegen --config codegen.yml",
    "db:migrate:gen": "sequelize migration:generate --name ",
    "db:migrate": "sequelize db:migrate --env \"development\"",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "db:migrate:status": "sequelize db:migrate:status",
    "db:seed:gen": "sequelize seed:generate --name ",
    "db:seed:undo": "sequelize db:seed:undo",
    "db:seed:all": "sequelize db:seed:all",
    "db:seed:undo:all": "sequelize db:seed:undo:all",
    "db:model:generate:initModel": "sequelize-auto -l ts -e mssql -o \"./src/db/models\" -a \"./src/db/config/model_additional.json\" -d WEBPM -h localhost -c \"./src/db/config/sequelize_auto_config.json\" -u sa -x 1234 --noAlias",
    "db:model:generate": "sequelize-auto -l ts -e mssql -o \"./src/db/models\" -a \"./src/db/config/model_additional.json\" -d WEBPM -h localhost -c \"./src/db/config/sequelize_auto_config.json\" -u sa -x 1234 --noAlias --noInitModels",
    "db:model:generate:initModel:js": "sequelize-auto -e -l es6 --caseProp c mssql -o \"./src/db/new-models\" -a \"./src/db/config/model_additional.json\" -d WEBPM_Dev -h localhost -c \"./src/db/config/sequelize_auto_config.json\" -u sa -x Om@4108459 --noAlias"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-request-context": "^1.0.1",
    "glob": "^10.3.10",
    "moment": "^2.30.1",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.4",
    "tedious": "^18.2.1",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.2",
    "@babel/node": "^7.22.19",
    "@babel/plugin-transform-class-properties": "^7.24.7",
    "@babel/plugin-transform-runtime": "^7.16.5",
    "@babel/preset-env": "^7.23.2",
    "@babel/register": "^7.11.5",
    "@jest-mock/express": "^2.1.0",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.13",
    "@types/sequelize": "^4.28.20",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "sequelize-auto": "^0.8.8",
    "sequelize-cli": "^6.6.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
